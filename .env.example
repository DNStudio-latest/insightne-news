# SECRET SETTINGS — this file is only an example. Never put real passwords in it.
# Real values go in: Vercel > Project > Settings > Environment Variables,
# and GitHub > Repository > Settings > Secrets and variables > Actions.
# For trying the site on your own computer, copy this file to ".env.local".

# Your approval page password. Make it long (for example four random words).
ADMIN_PASSWORD=

# Any long random text (at least 32 characters). It protects your sign-in.
SESSION_SECRET=

# From Supabase > Project Settings > API Keys. Leave empty for practice mode.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# From console.anthropic.com > API Keys. Only needed by the collector (GitHub), not by Vercel.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Default is claude-haiku-5-5 (lowest cost).
# CLAUDE_MODEL=claude-haiku-5-5
